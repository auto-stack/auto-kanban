// pages/board.at — 按当前板 kind 条件渲染（PLAN-021 双模式）：
//   lang_plans → 只读四列 + archived 折叠
//   manual     → 手动三列板（本文件内联视图；iced 路由页跨文件组件
//                调用不渲染——实测 2026-09-15，故不拆 ManualBoard 组件）
//
// UX 重设计 · VM/Vue parity 纪律（PLAN-038 Phase A + B）：
//   1. 本 app 缺省只写**核心**语义 token recipe（bg-background/bg-card/
//      border-border/bg-primary/text-muted-foreground/bg-destructive…）。
//      Phase B 起平台 scaffold 已吐出 success/warning/info/error（index.css
//      + tailwind），`.at` 可安全使用扩展色；本 app 缺省仍中性完成列/
//      P1=primary/10，直至产品侧决定恢复 text-success。
//   2. 不用硬编码 palette（bg-blue-500 / text-red-600 等）。
//   3. 模板只读预计算字段（VM view 不能调函数，Plan 402）。
//   4. 保留测试可定位文案：列名/占位符/按钮名（◀▶▲▼×/确认/保存…）。
//   5. 完成列/标题降噪为 muted；P1 优先级用 primary 弱底（P0=destructive）。
use store: BoardsStore

// ---- shared tokens（核心词表白名单，PLAN-038 Phase A）----
style board_pad = "p-4 gap-4 flex-1 min-h-0 overflow-auto"
style empty_panel = "p-8 items-center gap-2 bg-card rounded-xl border border-border"
style empty_title = "text-lg font-semibold text-foreground"
style empty_body = "text-sm text-muted-foreground text-center"
style col_shell = "w-72 bg-muted/40 rounded-xl flex-shrink-0 p-2 gap-2 border border-border"
style col_head = "items-center justify-between px-2 py-2 gap-2"
style col_name = "text-sm font-semibold text-foreground"
style col_name_primary = "text-sm font-semibold text-primary"
style col_name_muted = "text-sm font-semibold text-muted-foreground"
style col_count = "text-xs text-muted-foreground bg-card border border-border rounded-full px-2 py-0.5"
style col_count_primary = "text-xs text-primary bg-primary/10 border border-primary/30 rounded-full px-2 py-0.5"
style col_count_muted = "text-xs text-muted-foreground bg-muted border border-border rounded-full px-2 py-0.5"
style card_base = "w-full bg-card rounded-lg px-3 py-2 shadow-sm border border-border gap-2"
style card_click_row = "items-center gap-2 cursor-pointer w-full"
style card_title = "text-sm font-medium text-foreground truncate flex-1"
style card_detail = "text-xs text-muted-foreground truncate"
style time_label = "text-xs text-muted-foreground shrink-0"
style act_btn = "text-xs text-muted-foreground hover:text-primary hover:bg-accent rounded px-1.5 py-0.5 w-auto"
style act_del = "text-xs text-muted-foreground hover:text-destructive hover:bg-destructive/10 rounded px-1.5 py-0.5 w-auto"
style act_confirm = "text-xs font-medium text-primary-foreground bg-destructive hover:bg-destructive/90 rounded px-2 py-0.5 w-auto"
style pri_p0 = "text-xs font-semibold text-destructive bg-destructive/10 rounded px-1.5 py-0.5 shrink-0"
style pri_p1 = "text-xs font-semibold text-primary bg-primary/10 rounded px-1.5 py-0.5 shrink-0"
style pri_p2 = "text-xs text-muted-foreground bg-muted rounded px-1.5 py-0.5 shrink-0"
style quick_row = "gap-2 items-center flex-wrap"
style input_base = "px-3 py-2 border border-input rounded-md text-sm bg-background text-foreground w-72"
style btn_primary = "px-4 py-2 rounded-md bg-primary text-primary-foreground text-sm font-medium hover:bg-primary/90 w-auto"
style btn_secondary = "px-4 py-2 rounded-md bg-secondary text-secondary-foreground text-sm font-medium hover:bg-secondary/80 w-auto"
style editor_panel = "bg-card rounded-xl border border-border p-4 gap-3 shadow-sm"
style field_label = "text-sm text-muted-foreground w-auto shrink-0"
style field_row = "items-center gap-2"
style pri_off = "px-3 py-1.5 rounded-md text-sm border border-border text-muted-foreground w-auto"
style pri_on_p0 = "px-3 py-1.5 rounded-md text-sm border border-destructive/50 bg-destructive/10 text-destructive font-medium w-auto"
style pri_on_p1 = "px-3 py-1.5 rounded-md text-sm border border-primary/40 bg-primary/10 text-primary font-medium w-auto"
style pri_on_p2 = "px-3 py-1.5 rounded-md text-sm border border-border bg-muted text-foreground font-medium w-auto"
style plan_id_chip = "text-xs font-medium text-primary bg-primary/10 rounded px-1.5 py-0.5"
style plan_badge = "text-xs text-muted-foreground border border-border rounded px-1"
style plan_card = "w-full bg-card rounded-lg px-3 py-2 shadow-sm border border-border gap-1"
style archived_panel = "mt-2 bg-card rounded-xl border border-border p-3 gap-2"
style archived_item = "w-64 bg-muted/40 rounded-lg px-3 py-2 border border-border gap-1"
style toggle_btn = "text-muted-foreground hover:text-foreground text-sm w-auto px-1"

widget board {
    msg { Init, ToggleArchived, TitleChanged, AddClick, CardClick(str), CloseEditor, SaveEditor, EditTitle(str), EditDetail(str), SetPriority(str), AskRemove(str), RemoveCard(str), MoveLeft(str, str), MoveRight(str, str), Shift(str, int), Drag(str), AllowDrop, DropCol(str) }

    view {
        col {
            style: board_pad
            if .store.current_kind == "lang_plans" {
            // 空态引导（数据源未找到/配置为空）
            if .store.empty {
                col {
                    style: empty_panel
                    text "未找到看板数据" { style: empty_title }
                    text "检查 boards.json 配置，或为看板条目的 root_env 设置数据源环境变量（lang-plans 板为 AUTO_LANG_ROOT）" { style: empty_body }
                }
            }
            // 四列看板（只读 · token 化）
            if !.store.empty {
                row {
                    style: "w-full gap-3 items-start"
                    // drafting
                    col {
                        style: col_shell
                        row {
                            style: col_head
                            text "Drafting" { style: col_name }
                            text .store.c_drafting { style: col_count }
                        }
                        col {
                            style: "gap-2"
                            for card in .store.cards {
                                if card.column == "drafting" {
                                    col {
                                        key: card.id
                                        style: plan_card
                                        row {
                                            style: "items-center gap-2"
                                            text card.id { style: plan_id_chip }
                                            if card.badge == "parked" {
                                                text "parked" { style: plan_badge }
                                            }
                                            text card.updated_at { style: time_label + " ml-auto" }
                                        }
                                        text card.title { style: card_title }
                                        text card.progress { style: "text-xs text-muted-foreground" }
                                    }
                                }
                            }
                        }
                    }
                    // executing
                    col {
                        style: col_shell
                        row {
                            style: col_head
                            text "Executing" { style: col_name_primary }
                            text .store.c_executing { style: col_count_primary }
                        }
                        col {
                            style: "gap-2"
                            for card in .store.cards {
                                if card.column == "executing" {
                                    col {
                                        key: card.id
                                        style: plan_card
                                        row {
                                            style: "items-center gap-2"
                                            text card.id { style: plan_id_chip }
                                            if card.badge == "parked" {
                                                text "parked" { style: plan_badge }
                                            }
                                            text card.updated_at { style: time_label + " ml-auto" }
                                        }
                                        text card.title { style: card_title }
                                        text card.progress { style: "text-xs text-muted-foreground" }
                                    }
                                }
                            }
                        }
                    }
                    // execution_done
                    col {
                        style: col_shell
                        row {
                            style: col_head
                            text "Execution Done" { style: col_name_muted }
                            text .store.c_done { style: col_count_muted }
                        }
                        col {
                            style: "gap-2"
                            for card in .store.cards {
                                if card.column == "execution_done" {
                                    col {
                                        key: card.id
                                        style: plan_card
                                        row {
                                            style: "items-center gap-2"
                                            text card.id { style: plan_id_chip }
                                            text card.updated_at { style: time_label + " ml-auto" }
                                        }
                                        text card.title { style: card_title }
                                        text card.progress { style: "text-xs text-muted-foreground" }
                                    }
                                }
                            }
                        }
                    }
                    // reviewed
                    col {
                        style: col_shell
                        row {
                            style: col_head
                            text "Reviewed" { style: col_name }
                            text .store.c_reviewed { style: col_count }
                        }
                        col {
                            style: "gap-2"
                            for card in .store.cards {
                                if card.column == "reviewed" {
                                    col {
                                        key: card.id
                                        style: plan_card
                                        row {
                                            style: "items-center gap-2"
                                            text card.id { style: plan_id_chip }
                                            text card.updated_at { style: time_label + " ml-auto" }
                                        }
                                        text card.title { style: card_title }
                                        text card.progress { style: "text-xs text-muted-foreground" }
                                    }
                                }
                            }
                        }
                    }
                }
                // Archived 折叠区
                col {
                    style: archived_panel
                    row {
                        style: "items-center gap-2"
                        button .toggle_label {
                            onclick: .ToggleArchived,
                            style: toggle_btn
                        }
                        text .store.archived_label { style: "text-sm font-medium text-muted-foreground" }
                    }
                    if .show_archived {
                        row {
                            style: "gap-2 flex-wrap"
                            for card in .store.archived_recent {
                                col {
                                    key: card.id
                                    style: archived_item
                                    row {
                                        style: "items-center gap-2"
                                        text card.id { style: "text-xs font-medium text-muted-foreground" }
                                        text card.updated_at { style: time_label + " ml-auto" }
                                    }
                                    text card.title { style: "text-xs text-foreground truncate" }
                                }
                            }
                        }
                    }
                }
            }
            }
            if .store.current_kind == "manual" {
                // 快速添加（新卡默认进「待办」）
                row {
                    style: quick_row
                    input {
                        placeholder: "输入卡片标题…",
                        value: .new_title,
                        oninput: .TitleChanged,
                        style: input_base
                    }
                    button "＋ 添加" {
                        onclick: .AddClick,
                        style: btn_primary
                    }
                }
                // 整板空态（引导添加——manual 空非错误空态）
                if .store.manual_empty {
                    col {
                        style: empty_panel
                        text "看板还是空的" { style: empty_title }
                        text "点击上方添加第一张卡片" { style: empty_body }
                    }
                }
                // 三列 · 中性表面 + 状态色标题（不再整列染色）
                row {
                    style: "w-full gap-3 items-start"
                    // 待办 todo
                    col {
                        style: col_shell
                        ondragover.prevent: .AllowDrop
                        ondrop: .DropCol("todo")
                        row {
                            style: col_head
                            text "待办" { style: col_name }
                            text .store.c_todo { style: col_count }
                        }
                        col {
                            style: "gap-2"
                            for card in .store.cards {
                                if card.column == "todo" {
                                    col {
                                        key: card.id
                                        draggable: true
                                        ondragstart: .Drag(card.id)
                                        style: card_base
                                        row {
                                            onclick: .CardClick(card.id),
                                            style: card_click_row
                                            if card.priority == "P0" {
                                                text "P0" { style: pri_p0 }
                                            }
                                            if card.priority == "P1" {
                                                text "P1" { style: pri_p1 }
                                            }
                                            if card.priority == "P2" {
                                                text "P2" { style: pri_p2 }
                                            }
                                            text card.title { style: card_title }
                                            text card.updated_at { style: time_label }
                                        }
                                        if card.detail != "" {
                                            text card.detail { style: card_detail }
                                        }
                                        row {
                                            style: "items-center gap-1"
                                            button "◀" { onclick: .MoveLeft(card.id, card.column), style: act_btn }
                                            button "▶" { onclick: .MoveRight(card.id, card.column), style: act_btn }
                                            button "▲" { onclick: .Shift(card.id, -1), style: act_btn }
                                            button "▼" { onclick: .Shift(card.id, 1), style: act_btn }
                                            if .store.confirm_delete_id == card.id {
                                                button "确认" { onclick: .RemoveCard(card.id), style: act_confirm }
                                            } else {
                                                button "×" { onclick: .AskRemove(card.id), style: act_del }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // 进行中 doing（标题/count 跟 accent/primary）
                    col {
                        style: col_shell
                        ondragover.prevent: .AllowDrop
                        ondrop: .DropCol("doing")
                        row {
                            style: col_head
                            text "进行中" { style: col_name_primary }
                            text .store.c_doing { style: col_count_primary }
                        }
                        col {
                            style: "gap-2"
                            for card in .store.cards {
                                if card.column == "doing" {
                                    col {
                                        key: card.id
                                        draggable: true
                                        ondragstart: .Drag(card.id)
                                        style: card_base
                                        row {
                                            onclick: .CardClick(card.id),
                                            style: card_click_row
                                            if card.priority == "P0" {
                                                text "P0" { style: pri_p0 }
                                            }
                                            if card.priority == "P1" {
                                                text "P1" { style: pri_p1 }
                                            }
                                            if card.priority == "P2" {
                                                text "P2" { style: pri_p2 }
                                            }
                                            text card.title { style: card_title }
                                            text card.updated_at { style: time_label }
                                        }
                                        if card.detail != "" {
                                            text card.detail { style: card_detail }
                                        }
                                        row {
                                            style: "items-center gap-1"
                                            button "◀" { onclick: .MoveLeft(card.id, card.column), style: act_btn }
                                            button "▶" { onclick: .MoveRight(card.id, card.column), style: act_btn }
                                            button "▲" { onclick: .Shift(card.id, -1), style: act_btn }
                                            button "▼" { onclick: .Shift(card.id, 1), style: act_btn }
                                            if .store.confirm_delete_id == card.id {
                                                button "确认" { onclick: .RemoveCard(card.id), style: act_confirm }
                                            } else {
                                                button "×" { onclick: .AskRemove(card.id), style: act_del }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // 完成 done
                    col {
                        style: col_shell
                        ondragover.prevent: .AllowDrop
                        ondrop: .DropCol("done")
                        row {
                            style: col_head
                            text "完成" { style: col_name_muted }
                            text .store.c_done_m { style: col_count_muted }
                        }
                        col {
                            style: "gap-2"
                            for card in .store.cards {
                                if card.column == "done" {
                                    col {
                                        key: card.id
                                        draggable: true
                                        ondragstart: .Drag(card.id)
                                        style: card_base
                                        row {
                                            onclick: .CardClick(card.id),
                                            style: card_click_row
                                            if card.priority == "P0" {
                                                text "P0" { style: pri_p0 }
                                            }
                                            if card.priority == "P1" {
                                                text "P1" { style: pri_p1 }
                                            }
                                            if card.priority == "P2" {
                                                text "P2" { style: pri_p2 }
                                            }
                                            text card.title { style: card_title }
                                            text card.updated_at { style: time_label }
                                        }
                                        if card.detail != "" {
                                            text card.detail { style: card_detail }
                                        }
                                        row {
                                            style: "items-center gap-1"
                                            button "◀" { onclick: .MoveLeft(card.id, card.column), style: act_btn }
                                            button "▶" { onclick: .MoveRight(card.id, card.column), style: act_btn }
                                            button "▲" { onclick: .Shift(card.id, -1), style: act_btn }
                                            button "▼" { onclick: .Shift(card.id, 1), style: act_btn }
                                            if .store.confirm_delete_id == card.id {
                                                button "确认" { onclick: .RemoveCard(card.id), style: act_confirm }
                                            } else {
                                                button "×" { onclick: .AskRemove(card.id), style: act_del }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // 编辑面板（token 化卡片表面；点卡片打开）
                if .store.editing_id != "" {
                    col {
                        style: editor_panel
                        row {
                            style: "items-center gap-2"
                            text "编辑卡片" { style: "text-sm font-semibold text-foreground" }
                            text .store.editing_id { style: plan_id_chip }
                        }
                        row {
                            style: field_row
                            text "标题" { style: field_label }
                            input {
                                value: .store.edit_title,
                                oninput: .EditTitle,
                                placeholder: "卡片标题…",
                                style: "px-3 py-2 border border-input rounded-md text-sm bg-background text-foreground flex-1"
                            }
                        }
                        row {
                            style: field_row
                            text "优先级" { style: field_label }
                            button "P0 紧急" {
                                onclick: .SetPriority("P0"),
                                style: if .store.edit_priority == "P0" { pri_on_p0 } else { pri_off }
                            }
                            button "P1 高" {
                                onclick: .SetPriority("P1"),
                                style: if .store.edit_priority == "P1" { pri_on_p1 } else { pri_off }
                            }
                            button "P2 普通" {
                                onclick: .SetPriority("P2"),
                                style: if .store.edit_priority == "P2" { pri_on_p2 } else { pri_off }
                            }
                        }
                        col {
                            style: "gap-1"
                            text "详情" { style: field_label }
                            textarea {
                                value: .store.edit_detail,
                                oninput: .EditDetail,
                                placeholder: "多行详情…",
                                style: "w-full px-3 py-2 border border-input rounded-md text-sm bg-background text-foreground min-h-20"
                            }
                        }
                        row {
                            style: "items-center gap-2"
                            button "保存" {
                                onclick: .SaveEditor,
                                style: btn_primary
                            }
                            button "取消" {
                                onclick: .CloseEditor,
                                style: btn_secondary
                            }
                        }
                    }
                }
            }
        }
    }

    model {
        // 折叠区本地显隐与标签（数据在 store；标签本地——视图不能调函数）
        var show_archived bool = false
        var toggle_label str = "▸"
        // 快速添加行输入缓冲（022 board.at 同型；值绑定自动回写）
        var new_title str = ""
    }

    on {
        .Init -> { }
        .ToggleArchived -> {
            .show_archived = !.show_archived
            if .show_archived {
                .toggle_label = "▾"
            } else {
                .toggle_label = "▸"
            }
        }
        .Init -> { }
        .AddClick -> {
            if .new_title != "" {
                store.AddCard(.new_title)
                .new_title = ""
            }
        }
        .CardClick(cid str) -> {
            // 编辑面板打开时点其他卡切换目标（含删除确认切换的对称语义）
            store.OpenEditor(cid)
        }
        .CloseEditor -> { store.CloseEditor() }
        .SaveEditor -> { store.SaveEditor() }
        .EditTitle(v str) -> { store.EditTitle(v) }
        .EditDetail(v str) -> { store.EditDetail(v) }
        .SetPriority(p str) -> { store.SetPriority(p) }
        .AskRemove(cid str) -> { store.AskRemove(cid) }
        .RemoveCard(cid str) -> { store.RemoveCard(cid) }
        .MoveLeft(cid str, col str) -> {
            if col == "doing" {
                store.MoveCard(cid, "todo")
            }
            if col == "done" {
                store.MoveCard(cid, "doing")
            }
        }
        .MoveRight(cid str, col str) -> {
            if col == "todo" {
                store.MoveCard(cid, "doing")
            }
            if col == "doing" {
                store.MoveCard(cid, "done")
            }
        }
        .Shift(cid str, d int) -> { store.ShiftCard(cid, d) }
        .Drag(cid str) -> { store.DragCard(cid) }
        .AllowDrop -> { }
        .DropCol(col str) -> { store.DropCol(col) }
    }
}
