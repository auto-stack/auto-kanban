// boards_store.at — shared store (k1 pattern, cf. 022 board_store / 018 book_store).
// Holds the board registry + current board's cards; pages do `use store: BoardsStore`.
//
// 计数字段/最近归档在 handler 内预计算——VM view 不能调函数（Plan 402
// 约束），模板只读字段。handler 间互调沿 041/038/013 先例（.LoadCurrent()）。
use back.api: list_boards, board_cards, create_card, update_card, move_card, delete_card, update_card, move_card, delete_card

/// 写端点 body JSON 串构造用转义（语义同后端 manual_store.json_escape：
/// 先反斜杠后引号再控制字符；VM 位置参数制下写端点第二形参为整条原始
/// body 串，生成客户端按形参名包一层 {body: <此处构造的串>}，PLAN-021）。
fn esc(s str) str {
    var out str = s
    out = out.replace("\\", "\\\\")
    out = out.replace("\"", "\\\"")
    out = out.replace("\n", "\\n")
    out = out.replace("\t", "\\t")
    out = out.replace("\r", "\\r")
    return out
}

store BoardsStore {
    model {
        var boards []BoardDef = []
        var cards []Card = []
        var meta Meta = Meta { source_root: "", scanned_at: "", count_active: 0, count_archived: 0 }
        var current_id str = ""
        var current_title str = ""
        var current_kind str = ""
        var loading bool = false
        // 空态判据：加载完成但零板/零卡（source_root 跨 fn 返回有静默归 0
        // 残留（Plan 583 债族），判据只用计数不用 source_root）。
        var empty bool = false
        // 四列计数（handler 预计算 + 预格式——VM view 不能调函数）
        var n_drafting int = 0
        var n_executing int = 0
        var n_done int = 0
        var n_reviewed int = 0
        var c_drafting str = "0"
        var c_executing str = "0"
        var c_done str = "0"
        var c_reviewed str = "0"
        // manual 板三列计数（handler 预格式——VM view 不能调函数）
        var c_todo str = "0"
        var c_doing str = "0"
        var c_done_m str = "0"
        // manual 板整板空（引导添加态；.empty 对 manual 恒 false）
        var manual_empty bool = false
        // 编辑面板缓冲（Open 时从卡拷入，Save 时提交，Close/Save 后清）
        var editing_id str = ""
        var edit_title str = ""
        var edit_detail str = ""
        var edit_priority str = ""
        // 两击删除：当前确认目标（""=无；点其他卡 × 换目标）
        var confirm_delete_id str = ""
        // Vue 拖拽增强通道：被拖卡 id（022 drag_id 同型）
        var drag_id str = ""
        var archived_label str = ""
        // archived 折叠区
        var show_archived bool = false
        var archived_recent []Card = []
        var toggle_label str = "▸"
        // header 计数标签（预格式）
        var counts_label str = ""
    }

    msg { Init, Refresh, SelectBoard(str), ToggleArchived, LoadCurrent, AddCard(str), OpenEditor(str), CloseEditor, SaveEditor, EditTitle(str), EditDetail(str), SetPriority(str), AskRemove(str), RemoveCard(str), MoveCard(str, str), ShiftCard(str, int), DragCard(str), DropCol(str) }

    on {
        .Init -> {
            .loading = true
            .boards = list_boards()
            if .boards.len() > 0 {
                .current_id = .boards[0].id
                .current_title = .boards[0].title
                .current_kind = .boards[0].kind
                .LoadCurrent()
            } else {
                .empty = true
            }
            .loading = false
        }
        .Refresh -> {
            .loading = true
            .boards = list_boards()
            // Refresh 后按 id 恢复 kind（boards 可能整体重建）
            var i int = 0
            while i < .boards.len() {
                if .boards[i].id == .current_id {
                    .current_kind = .boards[i].kind
                    .current_title = .boards[i].title
                }
                i = i + 1
            }
            .LoadCurrent()
            .loading = false
        }
        .SelectBoard(id str) -> {
            var found bool = false
            var i int = 0
            while i < .boards.len() {
                if .boards[i].id == id {
                    .current_id = id
                    .current_title = .boards[i].title
                    .current_kind = .boards[i].kind
                    found = true
                }
                i = i + 1
            }
            if found {
                .LoadCurrent()
            }
        }
        .ToggleArchived -> {
            .show_archived = !.show_archived
            if .show_archived {
                .toggle_label = "▾"
            } else {
                .toggle_label = "▸"
            }
        }
        .AddCard(title str) -> {
            // 空标题拦（前端双重保险——后端 manual_store.create 同拦）
            if title != "" {
                if .current_kind == "manual" {
                    let body str = "{\"title\":\"" + esc(title) + "\",\"column\":\"todo\"}"
                    create_card(.current_id, body)
                    .LoadCurrent()
                }
            }
        }
        .OpenEditor(cid str) -> {
            .editing_id = cid
            var i int = 0
            while i < .cards.len() {
                if .cards[i].id == cid {
                    .edit_title = .cards[i].title
                    .edit_detail = .cards[i].detail
                    .edit_priority = .cards[i].priority
                }
                i = i + 1
            }
        }
        .CloseEditor -> {
            .editing_id = ""
        }
        .SaveEditor -> {
            if .editing_id != "" {
                let body str = "{\"title\":\"" + esc(.edit_title) + "\",\"detail\":\"" + esc(.edit_detail) + "\",\"priority\":\"" + esc(.edit_priority) + "\"}"
                update_card(.current_id, .editing_id, body)
                .editing_id = ""
                .LoadCurrent()
            }
        }
        .EditTitle(v str) -> {
            .edit_title = v
        }
        .EditDetail(v str) -> {
            .edit_detail = v
        }
        .SetPriority(p str) -> {
            .edit_priority = p
        }
        .AskRemove(cid str) -> {
            // 首击 ×：置/换确认目标（不弹窗不计时，PLAN-021 §5.6）
            .confirm_delete_id = cid
        }
        .RemoveCard(cid str) -> {
            // 再击确认：cid 相符才执行；删后清确认位重拉
            if .confirm_delete_id == cid {
                delete_card(.current_id, cid)
                .confirm_delete_id = ""
                .LoadCurrent()
            }
        }
        .MoveCard(cid str, col str) -> {
            // 落目标列尾部：order = 该列现卡数
            if .current_kind == "manual" {
                var tail int = 0
                var i int = 0
                while i < .cards.len() {
                    if .cards[i].column == col {
                        tail = tail + 1
                    }
                    i = i + 1
                }
                let body str = "{\"column\":\"" + col + "\",\"order\":" + tail.str() + "}"
                move_card(.current_id, cid, body)
                .LoadCurrent()
            }
        }
        .ShiftCard(cid str, d int) -> {
            // ▲▼：与相邻卡换位 = 目标位插入语义下给邻卡 order（一次调用）
            if .current_kind == "manual" {
                var col str = ""
                var ord int = 0
                var found bool = false
                var i int = 0
                while i < .cards.len() {
                    if .cards[i].id == cid {
                        col = .cards[i].column
                        ord = .cards[i].order
                        found = true
                    }
                    i = i + 1
                }
                if found {
                    var target int = ord + d
                    var neighbor int = -1
                    var j int = 0
                    while j < .cards.len() {
                        if .cards[j].column == col {
                            if .cards[j].order == target {
                                neighbor = .cards[j].order
                            }
                        }
                        j = j + 1
                    }
                    if neighbor >= 0 {
                        let body str = "{\"column\":\"" + col + "\",\"order\":" + neighbor.str() + "}"
                        move_card(.current_id, cid, body)
                        .LoadCurrent()
                    }
                }
            }
        }
        .DragCard(cid str) -> {
            .drag_id = cid
        }
        .DropCol(col str) -> {
            if .drag_id != "" {
                .MoveCard(.drag_id, col)
                .drag_id = ""
            }
        }
        .LoadCurrent -> {
            if .current_id == "" {
                return
            }
            let r CardsResult = board_cards(.current_id)
            .cards = r.cards
            .meta = r.meta
            .n_drafting = 0
            .n_executing = 0
            .n_done = 0
            .n_reviewed = 0
            .archived_recent = []
            // manual 板三列计数（handler 局部累加，出循环后预格式）
            var n_todo int = 0
            var n_doing int = 0
            var n_done_m int = 0
            var i int = 0
            while i < r.cards.len() {
                let c Card = r.cards[i]
                if c.column == "drafting" {
                    .n_drafting = .n_drafting + 1
                }
                if c.column == "executing" {
                    .n_executing = .n_executing + 1
                }
                if c.column == "execution_done" {
                    .n_done = .n_done + 1
                }
                if c.column == "reviewed" {
                    .n_reviewed = .n_reviewed + 1
                }
                if c.column == "todo" {
                    n_todo = n_todo + 1
                }
                if c.column == "doing" {
                    n_doing = n_doing + 1
                }
                if c.column == "done" {
                    n_done_m = n_done_m + 1
                }
                // 最近归档 5 张（updated_at 字符串序即日期序；容量满则
                // 挤掉 recent 中最旧者）
                if c.archived {
                    if .archived_recent.len() < 5 {
                        .archived_recent.push(c)
                    } else {
                        var oldest int = 0
                        var k int = 1
                        while k < .archived_recent.len() {
                            if .archived_recent[k].updated_at < .archived_recent[oldest].updated_at {
                                oldest = k
                            }
                            k = k + 1
                        }
                        if c.updated_at > .archived_recent[oldest].updated_at {
                            .archived_recent[oldest] = c
                        }
                    }
                }
                i = i + 1
            }
            // 空态判据：仅 lang_plans 板空 = 错误空态；manual 板空 = 引导
            // 添加（非错误）。未知 kind 同样不算错误空态（页面按 kind 分支）。
            var is_empty bool = false
            if .cards.len() == 0 {
                if .current_kind == "lang_plans" {
                    is_empty = true
                }
            }
            .empty = is_empty
            .c_drafting = .n_drafting.str()
            .c_executing = .n_executing.str()
            .c_done = .n_done.str()
            .c_reviewed = .n_reviewed.str()
            .c_todo = n_todo.str()
            .c_doing = n_doing.str()
            .c_done_m = n_done_m.str()
            var is_manual_empty bool = false
            if .cards.len() == 0 {
                if .current_kind == "manual" {
                    is_manual_empty = true
                }
            }
            .manual_empty = is_manual_empty
            .counts_label = r.meta.count_active.str() + " active / " + r.meta.count_archived.str() + " archived"
            .archived_label = "Archived · " + r.meta.count_archived.str() + " · 最近 5 张（按 updated_at）"
        }
    }
}
