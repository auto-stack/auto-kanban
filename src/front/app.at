// app.at — App shell. Single-page board; routes just render the board page.
// store import 与页面同别名 `store`（022 app/board 同型）。
//
// UX 重设计（VM/Vue parity · PLAN-038 Phase A）：样式只引用 AutoUI **核心**
// 语义 token（bg-background/bg-card/border-border/bg-primary/text-muted-foreground
// 等，codegen generate_base_css 已生成键），双端经同一 ThemeRegistry 解析，
// 深浅主题与 accent 自动跟随。禁止硬编码 palette；禁止扩展色 success/warning
// （脚手架未吐变量——平台债归 Phase B / P657-D2，不在本 app 打 gen 补丁）。
use store: BoardsStore

// 分段切换：选中 = primary 软底，未选中 = ghost 边框（Linear quiet chrome）
style page_shell = "min-h-screen bg-background text-foreground"
style chrome_bar = "w-full items-center gap-3 px-4 py-3 border-b border-border bg-card shrink-0"
style brand_name = "text-sm font-semibold tracking-tight text-foreground"
style brand_board = "text-xs text-muted-foreground shrink-0"
style seg_btn = "px-3 py-1.5 rounded-md text-sm border border-border text-muted-foreground hover:bg-accent w-auto"
style seg_btn_on = "px-3 py-1.5 rounded-md text-sm border border-primary/40 bg-primary/15 text-primary font-medium w-auto"
style btn_refresh = "px-3 py-1.5 rounded-md text-sm bg-primary text-primary-foreground font-medium hover:bg-primary/90 w-auto"
style counts_label = "text-xs text-muted-foreground tabular-nums"
style chrome_actions = "items-center gap-2 flex-wrap justify-end"
style route_col = "flex-1 min-h-0"

widget App {
    routes {
        "/" -> use board
    }

    msg { Init, Refresh, SelectBoard(str) }

    view {
        col {
            style: page_shell
            // Header / chrome
            row {
                style: chrome_bar
                row {
                    style: "items-center gap-2 min-w-0"
                    text "AutoUI Kanban" { style: brand_name }
                    text .store.current_title { style: brand_board }
                }
                spacer
                row {
                    style: chrome_actions
                    // 板切换（配置驱动；当前板高亮 = 模式指示）
                    for b in .store.boards {
                        button b.title {
                            onclick: .SelectBoard(b.id),
                            style: if b.id == .store.current_id { seg_btn_on } else { seg_btn }
                        }
                    }
                    text .store.counts_label { style: counts_label }
                    button "↻ 刷新" {
                        onclick: .Refresh,
                        style: btn_refresh
                    }
                }
            }
            // Route outlet
            col {
                style: route_col
                outlet
            }
        }
    }

    on {
        .Init -> { store.Init() }
        .Refresh -> { store.Refresh() }
        .SelectBoard(id str) -> { store.SelectBoard(id) }
    }
}
