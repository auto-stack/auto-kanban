// boards_registry.at — 看板注册中心：读 boards.json + kind 分发缝。
//
// v1 唯一 kind = "lang_plans"（lang_plans.at）。未来新看板类型 = 新适配器
// 模块 + boards.json 条目，本文件的 dispatch 加一行（Plan 579 v1 边界：
// 只留 seam，不预建注册机制）。
//
// 容器纪律：VM 后端上下文无 List[T] 泛型（实测 Undefined variable: List），
// 一律用裸数组 []T + push（front store 同型，041 .tabs.push 先例）。
//
// 配置路径解析：Env.get("AUTO_KANBAN_BOARDS") 覆盖 → 默认仓根 boards.json
// （auto run 的 CWD）。文件缺失 → 空列表（前端空态）；内容损坏 → decode
// 报错（配置 bug 应当响亮）。
//
// 错误透传约定：未知 board id / 未知 kind → 空 cards + meta.source_root
// 携带错误信息（前端据此显示空态引导）。

use api: BoardDef, Card, Meta, CardsResult
use lang_plans
use manual_store
use auto.file
use auto.env
use auto.json

/// boards.json 路径：env 覆盖 → 仓根默认。
fn boards_config_path() str {
    let p str = env.get("AUTO_KANBAN_BOARDS")
    if p != "" {
        return p
    }
    return "boards.json"
}

/// boards.json 的解码走动态 JsonValue 导航（VM codegen 不支持
/// json.decode[T] 泛型实例化调用，codegen.rs:9713 not implemented——
/// 06_todo_api.at 的 data.title 动态访问同型）。
fn board_defs_from_text(text str) []BoardDef {
    var result []BoardDef = []
    let parsed = json.parse(text)
    if parsed == nil {
        return result
    }
    let entries = parsed.boards
    if entries == nil {
        return result
    }
    for entry in entries {
        let def = BoardDef { id: entry.id, title: entry.title, kind: entry.kind, root_env: entry.root_env }
        result.push(def)
    }
    return result
}

/// 读看板注册配置。
pub fn load_boards() []BoardDef {
    let path str = boards_config_path()
    if !file.exists(path) {
        return []
    }
    let text str = file.read_text(path)
    return board_defs_from_text(text)
}

/// 错误结果：空 cards + 错误串 meta（source_root 字段透传前端空态）。
fn error_result(msg str) CardsResult {
    let cards []Card = []
    let meta = Meta { source_root: msg, scanned_at: "", count_active: 0, count_archived: 0 }
    let result = CardsResult { cards: cards, meta: meta }
    return result
}

/// 零值卡（写端点非法板门返回值；id="" 供诊断区分）。
fn zero_card_def() Card {
    let z = Card { id: "", title: "", column: "", badge: "", current: 0, total: 0, progress: "—", updated_at: "", archived: false, file: "", detail: "", priority: "", order: 0 }
    return z
}

/// body JSON 的 str 字段解包（解析失败/缺字段 → ""）。VM HTTP 后端把
/// 请求体作为单个原始字符串推给 handler（Plan 346 位置参数制），解包
/// 在本模块做——api.at 是后端编译入口，Plan 550 门 E5501 禁 nil 字面量。
/// 注意：①取值必须 json.as_string（""+JsonValue 得 JSON 编码形态带引号，
/// 2026-09-15 实测）；②缺字段判定必须 json.has_key——json.get 对缺失键
/// 返回非 nil Null 值（实测），== nil 判不中。
/// 双形态兼容：curl 直发 {"title":…}（顶层字段）与生成客户端
/// {"body":"{\"title\":…}"}（非路径参数按形参名包一层，双层编码）都收。
fn body_str(body str, key str) str {
    var out str = ""
    let parsed = json.parse(body)
    if parsed == nil {
        return out
    }
    if json.has_key(parsed, key) {
        let v = json.get(parsed, key)
        out = json.as_string(v)
        return out
    }
    if json.has_key(parsed, "body") {
        let inner = json.get(parsed, "body")
        let inner_text str = json.as_string(inner)
        let nested = json.parse(inner_text)
        if nested != nil {
            if json.has_key(nested, key) {
                let v2 = json.get(nested, key)
                out = json.as_string(v2)
            }
        }
    }
    return out
}

/// body JSON 的 int 字段解包（解析失败/缺字段 → 0；双形态兼容同 body_str）。
fn body_int(body str, key str) int {
    var out int = 0
    let parsed = json.parse(body)
    if parsed == nil {
        return out
    }
    if json.has_key(parsed, key) {
        let v = json.get(parsed, key)
        out = json.as_int(v)
        return out
    }
    if json.has_key(parsed, "body") {
        let inner = json.get(parsed, "body")
        let inner_text str = json.as_string(inner)
        let nested = json.parse(inner_text)
        if nested != nil {
            if json.has_key(nested, key) {
                let v2 = json.get(nested, key)
                out = json.as_int(v2)
            }
        }
    }
    return out
}

/// 写端点 kind 门：板存在且 kind == "manual" 才允许写（lang_plans 源
/// 禁写——Plan 579 边界延续；未知板同拒）。
pub fn is_manual(id str) bool {
    let defs = load_boards()
    var ok bool = false
    for b in defs {
        if b.id == id {
            if b.kind == "manual" {
                ok = true
            }
        }
    }
    return ok
}

/// 写分发（沿读路径 seam）：POST 建卡（body: title/column）。
pub fn create_card(id str, body str) Card {
    var result Card = zero_card_def()
    if is_manual(id) {
        let title str = body_str(body, "title")
        let column str = body_str(body, "column")
        result = manual_store.create(title, column)
    }
    return result
}

/// 写分发：PUT 编辑三字段（body: title/detail/priority）。
pub fn update_card(id str, cid str, body str) Card {
    var result Card = zero_card_def()
    if is_manual(id) {
        let title str = body_str(body, "title")
        let detail str = body_str(body, "detail")
        let priority str = body_str(body, "priority")
        result = manual_store.update(cid, title, detail, priority)
    }
    return result
}

/// 写分发：PUT 移动+排序（body: column/order，目标位插入）。
pub fn move_card(id str, cid str, body str) Card {
    var result Card = zero_card_def()
    if is_manual(id) {
        let column str = body_str(body, "column")
        let order int = body_int(body, "order")
        result = manual_store.move_card(cid, column, order)
    }
    return result
}

/// 写分发：DELETE 删卡（非 manual 板 false）。
pub fn delete_card(id str, cid str) bool {
    var ok bool = false
    if is_manual(id) {
        ok = manual_store.remove(cid)
    }
    return ok
}

/// kind 分发：按 id 找 BoardDef，按 kind 调对应适配器。
pub fn load_cards(id str) CardsResult {
    let defs = load_boards()
    var target BoardDef = BoardDef { id: "", title: "", kind: "", root_env: "" }
    var found bool = false
    for b in defs {
        if b.id == id {
            let copy = BoardDef { id: b.id, title: b.title, kind: b.kind, root_env: b.root_env }
            target = copy
            found = true
        }
    }
    if !found {
        return error_result("unknown board id: " + id)
    }
    if target.kind == "lang_plans" {
        return lang_plans.scan(target.root_env)
    }
    if target.kind == "manual" {
        return manual_store.load()
    }
    return error_result("unknown board kind: " + target.kind)
}
