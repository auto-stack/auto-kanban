// api.at — auto-kanban API.
// Types + endpoints only; logic lives in boards_registry.at（配置+kind 分发）
// 与 lang_plans.at（首个看板类型适配器）。前端经 `use back.api` 消费。

/// 一个看板的注册定义（boards.json 条目）。
pub type BoardDef = {
    id: str
    title: str
    kind: str
    root_env: str
}

/// 泛化卡片——与数据源解耦（计划板映射：id=plan_id, current/total=
/// current_step/total_steps, column=五态之一）。两 source 契约：全字段
/// 必填（lang_plans 填 detail=""/priority=""/order=0 默认值，manual 填
/// badge=""/current=0/total=0/progress="—"/archived=false/file=""）。
pub type Card = {
    id: str
    title: str
    column: str
    badge: str
    current: int
    total: int
    progress: str            // 预格式 "3/7" 或 "—"（VM view 不能调函数，Plan 402）
    updated_at: str
    archived: bool
    file: str
    detail: str              // 多行详情；lang_plans 恒 ""
    priority: str            // P0|P1|P2（manual）；lang_plans 恒 ""
    order: int               // 列内序（升序渲染，manual）；lang_plans 恒 0
}

/// 扫描元信息。source_root 为错误串时前端显示空态引导。
pub type Meta = {
    source_root: str
    scanned_at: str
    count_active: int
    count_archived: int
}

/// /api/boards/:id/cards 的返回聚合。
pub type CardsResult = {
    cards: []Card
    meta: Meta
}

use boards_registry

/// VM HTTP 后端约定（http_server.rs build_handler_args，Plan 346 位置
/// 参数制）：路径参数按声明序绑定，请求体作为**单个原始 JSON 字符串**
/// 追加到末位——字段解包在 boards_registry（body_json 解包臂；本文件
/// 是后端编译入口，Plan 550 门 E5501 禁 nil 字面量，故不在此解析）。

/// GET /api/boards — 看板列表（读 boards.json）。函数名避开 store 字段名
/// （list_boards/board_cards vs .boards/.cards，022 导入无撞名先例）。
#[api(method = "GET", path = "/api/boards")]
pub fn list_boards() []BoardDef {
    return boards_registry.load_boards()
}

/// GET /api/boards/:id/cards — 该板卡片 + meta。
#[api(method = "GET", path = "/api/boards/:id/cards")]
pub fn board_cards(id str) CardsResult {
    return boards_registry.load_cards(id)
}

/// POST /api/boards/:id/cards — 手动板建卡（经 registry 按 kind 分发；
/// 非 manual 板落零卡，前端以重拉 cards 为准，响应值仅诊断用）。
#[api(method = "POST", path = "/api/boards/:id/cards")]
pub fn create_card(id str, body str) Card {
    return boards_registry.create_card(id, body)
}

/// PUT /api/boards/:id/cards/:cid — 手动板编辑（标题/详情/优先级）。
#[api(method = "PUT", path = "/api/boards/:id/cards/:cid")]
pub fn update_card(id str, cid str, body str) Card {
    return boards_registry.update_card(id, cid, body)
}

/// PUT /api/boards/:id/cards/:cid/move — 手动板移动+排序（目标位插入）。
#[api(method = "PUT", path = "/api/boards/:id/cards/:cid/move")]
pub fn move_card(id str, cid str, body str) Card {
    return boards_registry.move_card(id, cid, body)
}

/// DELETE /api/boards/:id/cards/:cid — 手动板删卡（无 body）。
#[api(method = "DELETE", path = "/api/boards/:id/cards/:cid")]
pub fn delete_card(id str, cid str) bool {
    return boards_registry.delete_card(id, cid)
}
